NODE_ENV=development
PORT=3001

DB_PROVIDER=postgres
# Keep BOTH set so Admin → Settings can hot-switch without restart/.env edits
DATABASE_URL=postgresql://bloguser:blogpassword@localhost:5432/blogdb
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster/db

JWT_SECRET=dev-jwt-secret-change-in-production-minimum-8-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
COOKIE_SECURE=false

# OAuth (required for user signup via Google/GitHub)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_CALLBACK_URL=http://localhost:3001/api/auth

# pCloud OAuth (code flow → oauth2_token). Register this redirect URI in the pCloud app:
# http://localhost:3001/api/uploads/pcloud/callback
PCLOUD_CLIENT_ID=
PCLOUD_CLIENT_SECRET=
PCLOUD_REDIRECT_URI=http://localhost:3001/api/uploads/pcloud/callback
# Optional: paste a token instead of using Admin → Settings → Connect pCloud
PCLOUD_ACCESS_TOKEN=
# US: api.pcloud.com   EU: eapi.pcloud.com
PCLOUD_API_HOST=api.pcloud.com

LOG_LEVEL=debug
