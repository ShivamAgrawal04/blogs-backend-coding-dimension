generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum BlogStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ReactionType {
  LIKE
  DISLIKE
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          UserRole  @default(USER)
  bio           String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  blogs     Blog[]
  comments  Comment[]
  likes     Like[]
  bookmarks Bookmark[]
  reads     ReadHistory[]

  @@map("users")
}

model Blog {
  id              String     @id @default(cuid())
  title           String
  slug            String     @unique
  description     String     @db.Text
  content         String     @db.Text
  authorId        String
  category        String
  readTime        String     @default("")
  status          BlogStatus @default(DRAFT)
  featured        Boolean    @default(false)
  imageGradient   String     @default("from-[#033b2a] to-[#1e4d3a]")
  metaTitle       String?
  metaDescription String?    @db.Text
  views           Int        @default(0)
  publishedAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  author    User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  tags      BlogTag[]
  comments  Comment[]
  likes     Like[]
  bookmarks Bookmark[]
  reads     ReadHistory[]

  @@index([slug])
  @@index([category])
  @@index([status])
  @@map("blogs")
}

model Tag {
  id    String    @id @default(cuid())
  name  String    @unique
  slug  String    @unique
  blogs BlogTag[]

  @@map("tags")
}

model BlogTag {
  blogId String
  tagId  String
  blog   Blog @relation(fields: [blogId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([blogId, tagId])
  @@map("blog_tags")
}

model Subject {
  id        String @id @default(cuid())
  name      String
  slug      String @unique
  icon      String @default("📘")
  sortOrder Int    @default(0)
  notes     Note[]

  @@index([slug])
  @@map("subjects")
}

model Note {
  id          String   @id @default(cuid())
  slug        String
  title       String
  description String   @default("")
  content     String   @db.Text
  date        DateTime @default(now())
  readTime    String
  views       Int      @default(0)
  subjectId   String
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subject   Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  comments  Comment[]
  likes     Like[]
  bookmarks Bookmark[]
  reads     ReadHistory[]

  @@unique([subjectId, slug])
  @@index([subjectId])
  @@map("notes")
}

model Comment {
  id        String   @id @default(cuid())
  text      String   @db.Text
  userId    String
  blogId    String?
  noteId    String?
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  blog    Blog?     @relation(fields: [blogId], references: [id], onDelete: Cascade)
  note    Note?     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("CommentReplies")
  likes   Like[]

  @@index([blogId])
  @@index([noteId])
  @@index([parentId])
  @@map("comments")
}

model Like {
  id        String       @id @default(cuid())
  userId    String
  blogId    String?
  noteId    String?
  commentId String?
  type      ReactionType @default(LIKE)
  createdAt DateTime     @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  blog    Blog?    @relation(fields: [blogId], references: [id], onDelete: Cascade)
  note    Note?    @relation(fields: [noteId], references: [id], onDelete: Cascade)
  comment Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, blogId])
  @@unique([userId, noteId])
  @@unique([userId, commentId])
  @@map("likes")
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  blogId    String?
  noteId    String?
  createdAt DateTime @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  blog Blog? @relation(fields: [blogId], references: [id], onDelete: Cascade)
  note Note? @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@unique([userId, blogId])
  @@unique([userId, noteId])
  @@map("bookmarks")
}

model ReadHistory {
  id       String   @id @default(cuid())
  userId   String
  blogId   String?
  noteId   String?
  readAt   DateTime @default(now())
  progress Int      @default(0)

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  blog Blog? @relation(fields: [blogId], references: [id], onDelete: Cascade)
  note Note? @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@map("read_history")
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  active    Boolean  @default(true)
  token     String   @unique @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("newsletter_subscribers")
}

model PageView {
  id        String   @id @default(cuid())
  path      String
  ip        String?
  userAgent String?
  referer   String?
  userId    String?
  createdAt DateTime @default(now())

  @@index([path])
  @@index([createdAt])
  @@map("page_views")
}
